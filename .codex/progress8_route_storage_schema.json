{
  "version": "progress8_route_storage_schema_v1",
  "routes": {
    "GET /plan-c": {
      "template": "plan_c_home.html",
      "purpose": "Plan C introduction and Get Started"
    },
    "GET /plan-c/capture/<session_id>": {
      "template": "plan_c_capture.html",
      "purpose": "Clean camera capture page"
    },
    "GET /plan-c/processing/<session_id>": {
      "template": "plan_c_processing.html",
      "purpose": "Processing loader and polling"
    },
    "GET /plan-c/result/<session_id>": {
      "template": "plan_c_result.html",
      "purpose": "Annotated result and risk panel"
    },
    "GET /plan-c/map": {
      "template": "plan_c_map.html",
      "purpose": "Persistent marker map"
    },
    "GET /plan-c/developer/<session_id>": {
      "template": "plan_c_developer.html",
      "purpose": "Raw developer diagnostics"
    },
    "POST /api/plan-c/session/start": {
      "returns": ["session_id", "capture_url", "developer_url"],
      "http_success": 201
    },
    "POST /api/plan-c/session/tree-anchor": {
      "returns": ["gps_ready", "manual_distance_required"],
      "gps_must_not_block_camera": true,
      "http_success": 200
    },
    "POST /api/plan-c/session/snapshot": {
      "content_type": "multipart/form-data",
      "requires": ["session_id", "photo"],
      "optional": ["camera_latitude", "camera_longitude", "camera_accuracy_m", "manual_distance_m", "device_orientation", "note"],
      "http_success": 201
    },
    "GET /api/plan-c/session/<session_id>/status": {
      "returns": ["processing_status", "result_url"],
      "http_success": 200
    },
    "GET /api/plan-c/session/<session_id>/result": {
      "returns": ["result"],
      "http_success": 200
    }
  },
  "storage": {
    "root": "data/runtime/plan_c",
    "sessions": "data/runtime/plan_c/sessions/<session_id>",
    "required_session_files": {
      "original": "original.jpg",
      "annotated": "annotated.jpg",
      "result": "result.json",
      "developer": "developer.json",
      "metadata": "metadata.json",
      "yolo_raw": "yolo_raw.json",
      "ai_raw": "ai_raw.json",
      "geometry": "geometry.json"
    },
    "spreadsheet_csv": "data/runtime/plan_c/spreadsheet/plan_c_records.csv",
    "spreadsheet_jsonl": "data/runtime/plan_c/spreadsheet/plan_c_records.jsonl",
    "map_markers": "data/runtime/plan_c/map/plan_c_markers.json",
    "append_only": true
  },
  "csv_columns": [
    "record_id",
    "session_id",
    "timestamp",
    "point_id",
    "operator_name",
    "tree_anchor_lat",
    "tree_anchor_lon",
    "camera_lat",
    "camera_lon",
    "gps_accuracy_m",
    "manual_distance_m",
    "yolo_status",
    "ai_status",
    "risk_status",
    "prediction_window",
    "clearance_m",
    "tree_height_m",
    "confidence",
    "original_image",
    "annotated_image",
    "result_json",
    "map_marker_id",
    "notes"
  ]
}
