{
    "version":  "progress8_guardrails_v2",
    "forbidden_globs":  [
                            "*.pt",
                            "*.onnx",
                            "*.engine",
                            "*.tflite",
                            ".env",
                            ".env.*",
                            "*credential*",
                            "*secret*",
                            "*token*"
                        ],
    "forbidden_commands":  [
                               "git add .",
                               "git clean -fd",
                               "git reset --hard",
                               "git push --force"
                           ],
    "required_behaviors":  [
                               "new /plan-c route",
                               "append-only storage",
                               "no fake detection",
                               "no fake GPS",
                               "no realtime loop",
                               "preserve Plan A and Plan B"
                           ],
    "forbidden_paths":  [
                            "data/raw/",
                            "data/labels/",
                            "data/datasets/",
                            "runs/",
                            "weights/",
                            "models/",
                            "dataset_botol/",
                            "labels/"
                        ],
    "folder_policy":  {
                          "do_not_use_git_worktree":  true,
                          "only_use_root":  "E:\\Projects\\ULP_Project",
                          "do_not_create_external_project_folder":  true
                      }
}
